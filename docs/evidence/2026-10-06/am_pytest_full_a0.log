    def solve_enthalpy_thermal(*, geometry, process, params=None):
        """enthalpy 法相变热传导：移动激光热源 + 固液潜热。
    
        注册名 ``thermal.enthalpy``；consumes (geometry, process)；produces
        ``ThermalHistory``。材料自 ``params['material']`` 解析（默认 316L）。
