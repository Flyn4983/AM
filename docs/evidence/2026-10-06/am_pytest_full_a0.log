        n_steps_cfl = max(1, int(math.ceil(t_exp / dt_c - 1e-9))) if _ok else None
        n_steps_stable = max(1, int(math.ceil(t_exp / dt_r - 1e-9))) if _ok else None
    
        n_steps_user = p.get("n_steps")
        if n_steps_user is None:
            if n_steps_cfl is None:
